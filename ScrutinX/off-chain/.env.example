# Copy to .env.local (Next.js) or .env and fill in. NEVER commit the real file.

# --- Toggles: 'demo' (no chain) or 'real' (Preprod). Both default to 'demo'. ---
CONGESTION_MODE=demo
SETTLEMENT_MODE=demo

# --- Chain data / submit API. SERVER-SIDE ONLY. ---
# Primary: Blockfrost Preprod (public testnet — used for the final settlement + Cardanoscan link).
BLOCKFROST_URL=https://cardano-preprod.blockfrost.io/api/v0
BLOCKFROST_PROJECT_ID=preprodXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Alt (ADR-007): Yaci DevKit local devnet — Blockfrost-compatible, no key, instant blocks.
# Point BLOCKFROST_URL here to iterate fast; leave PROJECT_ID empty. Use the port Yaci prints.
# BLOCKFROST_URL=http://localhost:8080/api/v1/
# BLOCKFROST_PROJECT_ID=

# Alt (ADR-008): Koios — free, KEYLESS backup for congestion reads / submit (different request shapes).
# KOIOS_URL=https://preprod.koios.rest/api/v0

# --- On-chain wiring (fill once the validator is deployed) ---
# 24-word mnemonic of the funded Preprod seed wallet. SERVER-SIDE ONLY. Never expose to the browser.
WALLET_SEED="word1 word2 ... word24"
SCRIPT_ADDRESS=addr_test1...
PLUTUS_JSON_PATH=../on-chain/plutus.json
