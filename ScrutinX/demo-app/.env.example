# Copy to .env.local and fill in. NEVER commit .env.local. Secrets are SERVER-SIDE ONLY.

# --- Toggles: 'demo' (no chain) or 'real' (chain). Both default to 'demo'. ---
CONGESTION_MODE=demo
SETTLEMENT_MODE=demo

# --- Chain API. Primary = Blockfrost Preprod (used for the FINAL settlement). ---
BLOCKFROST_URL=https://cardano-preprod.blockfrost.io/api/v0
BLOCKFROST_PROJECT_ID=preprodXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- Alt (ADR-007): Yaci DevKit local devnet — fast iteration, no key. Use the port Yaci prints. ---
# BLOCKFROST_URL=http://localhost:8080/api/v1/
# BLOCKFROST_PROJECT_ID=

# --- On-chain wiring (fill once the validator is deployed). SERVER-SIDE ONLY. ---
WALLET_SEED="word1 word2 ... word24"
SCRIPT_ADDRESS=addr_test1...
PLUTUS_JSON_PATH=../on-chain/plutus.json
