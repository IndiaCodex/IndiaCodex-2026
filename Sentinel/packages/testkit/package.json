{
  "name": "@sentinel/testkit",
  "version": "0.1.0",
  "private": true,
  "description": "Shared domain fixtures for tests across Sentinel packages. Not published; not part of any runtime path.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@sentinel/domain": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "typescript": "^6.0.3"
  }
}
