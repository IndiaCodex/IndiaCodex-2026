{
  "name": "@sentinel/storage-memory",
  "version": "0.1.0",
  "private": true,
  "description": "In-memory StoragePort adapter: ephemeral local/demo storage, and the reference implementation the StoragePort contract test suite is validated against.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "default": "./dist/contract.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@sentinel/domain": "workspace:*"
  },
  "devDependencies": {
    "@sentinel/testkit": "workspace:*",
    "@types/node": "^22.19.21",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
