{
  "name": "@sentinel/domain",
  "version": "0.1.0",
  "private": true,
  "description": "Sentinel domain layer: entities, value objects, domain services, and ports. Zero framework dependencies.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
