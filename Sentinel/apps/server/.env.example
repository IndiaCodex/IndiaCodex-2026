# Copy to .env.local (or export directly) to override defaults.
# None of these are required — the server runs with sane local-dev
# defaults out of the box.

# HTTP bind address and port.
SENTINEL_HOST=0.0.0.0
SENTINEL_PORT=4000

# Pino log level: trace | debug | info | warn | error | fatal | silent
SENTINEL_LOG_LEVEL=info

# "sqlite" (default) or "memory" (ephemeral, no file — useful for CI or
# throwaway demos). SENTINEL_DB_PATH is ignored when set to "memory".
SENTINEL_STORAGE_DRIVER=sqlite
SENTINEL_DB_PATH=./data/sentinel.db

# Comma-separated list of allowed CORS origins. Unset (the default)
# allows any origin — fine for a local demo where the web app's origin
# is unpredictable (whatever port Vite picked); set this before exposing
# the server beyond localhost.
# SENTINEL_CORS_ORIGIN=http://localhost:5173,https://sentinel.example.com
