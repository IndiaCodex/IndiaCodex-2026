{
  "name": "@forge/sdk",
  "version": "0.0.0",
  "description": "Forge platform — the public facade every presentation layer (CLI, future IDE extensions) is built on.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@forge/application": "workspace:*",
    "@forge/domain": "workspace:*",
    "@forge/plugin-api": "workspace:*",
    "@forge/plugin-loader": "workspace:*"
  },
  "devDependencies": {
    "@forge/adapter-aiken": "workspace:*",
    "@forge/adapter-codegen-ts": "workspace:*",
    "@forge/adapter-emulator": "workspace:*",
    "@forge/adapter-filesystem": "workspace:*",
    "@forge/contract-templates": "workspace:*"
  }
}
