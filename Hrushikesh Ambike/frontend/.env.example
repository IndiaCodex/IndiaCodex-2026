# Ouro web demo — network configuration.
#
# The live Ouro contracts (oracle, per-owner vaults) and the deposit flow run
# on preprod. Copy this file to .env.local and fill in the Blockfrost key.

# "devnet" (local Yaci DevKit) or "preprod" (public Cardano testnet).
# Defaults to "devnet" when unset. Set to "preprod" to use the live deposit.
NEXT_PUBLIC_NETWORK=preprod

# SERVER-ONLY Blockfrost preprod project id, used by the /api/deposit/build
# route to resolve protocol params + coin-select UTxOs. NOT prefixed with
# NEXT_PUBLIC, so it never ships to the browser. Get one (free) at
# https://blockfrost.io (preprod tier). Put the real value in .env.local
# (gitignored), never here.
BLOCKFROST_PREPROD_PROJECT_ID=

# Optional display-only id (network label plumbing in networkConfig.ts).
# Leave empty unless you want the client UI to show a project id.
NEXT_PUBLIC_BLOCKFROST_PROJECT_ID=
