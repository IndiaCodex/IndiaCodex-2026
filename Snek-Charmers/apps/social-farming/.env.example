# Copy to .env. Ports match docker-compose.yml (offset to avoid clashing with the launchpad).
DATABASE_URL="postgresql://social:social@localhost:5433/social_farming?schema=public"
REDIS_URL="redis://localhost:6380"

PORT=4000

# Secret the launchpad uses to HMAC-sign inbound events (POST /events).
LAUNCHPAD_WEBHOOK_SECRET="dev-shared-secret-change-me"

# JWT signing secret for wallet-session tokens.
JWT_SECRET="dev-jwt-secret-change-me"
JWT_EXPIRES_IN="7d"

# Cardano network id for address validation. 0 = Preprod, 1 = mainnet.
NETWORK_ID=0
