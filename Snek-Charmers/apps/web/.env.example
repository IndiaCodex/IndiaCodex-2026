# Copy to .env.local and fill in. .env.local is git-ignored.

# Blockfrost project id for the PREPROD network.
# Get a free key at https://blockfrost.io — create a project and select "Cardano preprod".
# Exposed client-side (NEXT_PUBLIC) for this testnet milestone; proxy it server-side
# for production. Do not commit a real key.
NEXT_PUBLIC_BLOCKFROST_PROJECT_ID_PREPROD=preprodXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Cardano network id: 0 = Preprod (testnet), 1 = mainnet. Keep 0 for this milestone.
NEXT_PUBLIC_NETWORK_ID=0
