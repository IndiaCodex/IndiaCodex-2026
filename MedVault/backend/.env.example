# Copy this file to .env and fill in real values. Never commit .env.
APP_NAME="MediVault API"
ENVIRONMENT=development        # development | test | production
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://medivault:medivault@localhost:5433/medivault

# Auth - generate a long random secret for production!
JWT_SECRET=dev-only-change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Wallet linking
WALLET_CHALLENGE_MINUTES=5
# Dev-only: allows "mock:<address>" signatures in /docs. Never works in production.
ALLOW_MOCK_WALLET_SIGNATURES=true

# Cardano / Blockfrost (preprod)
BLOCKFROST_PROJECT_ID=your-preprod-project-id-here
POOL_WALLET_ADDRESS=addr_test1qpoolwalletplaceholder
MIN_TX_CONFIRMATIONS=1
# Dev-only: accept "mocktx:<from>:<lovelace>" hashes. Never works in production.
ALLOW_MOCK_CHAIN=true
